{
  "name": "family-tree",
  "version": "1.0.0",
  "description": "family tree to find and link your family members, and discover your ancerstors' stories",
  "author": "sophietk",
  "private": true,
  "engines": {
    "node": ">=20.x",
    "npm": ">=10.x"
  },
  "scripts": {
    "postinstall": "bower update",
    "heroku-postbuild": "run-s build",
    "start": "node ./server/server.js",
    "watch:sass": "nodemon --watch app/sass --ext scss --exec 'npm run sass'",
    "watch:handlebars": "nodemon --watch app/js --ext hbs --exec 'npm run handlebars'",
    "watch:i18n": "nodemon --watch app/js/i18n/en.js --watch app/js/i18n/fr.js --exec 'npm run handlebars:templates'",
    "watch": "run-p watch:*",
    "test": "run-p lint:*",
    "lint:js": "eslint .",
    "build": "run-s clean:dist && run-s generate-build-date generate-build-commit && run-p sass handlebars copy-assets && run-s usemin replace:cssfont",
    "generate-build-date": "date=$(TZ=Europe/Paris date '+%Y-%m-%d %H:%M'); replace-in-file local-dev \"$date\" app/js/root.hbs",
    "generate-build-commit": "commit=$(printf \"%s\" \"$RENDER_GIT_COMMIT\" | cut -c1-8); replace-in-file local-work \"$commit\" app/js/root.hbs",
    "dist": "run-p build clean:zip && run-s compress",
    "clean:dist": "rm -rf dist",
    "clean:zip": "rm -rf zip",
    "sass": "sass app/sass/style.scss app/css/style.css",
    "handlebars": "run-p handlebars:templates handlebars:partials",
    "handlebars:templates": "handlebars app/js/*.hbs app/js/**/*.hbs app/js/**/**/*.hbs -f app/js/templates.js",
    "handlebars:partials": "handlebars app/js/**/*.partial.hbs app/js/**/**/*.partial.hbs -p -f app/js/partials.js",
    "copy-assets": "mkdir dist; run-p copy:*",
    "copy:img": "cp -r app/img dist/",
    "copy:font": "mkdir dist/font && cp -r app/bower_components/material-design-icons-font/iconfont dist/font/material-design-icons",
    "copy:i18n": "mkdir dist/js; cp -r app/js/i18n dist/js/",
    "usemin": "usemin app/index.html -d dist > dist/index.html",
    "replace:cssfont": "replace-in-file ../font/ ./font/ dist/style.min.css",
    "compress": "mkdir zip; zip -r zip/$npm_package_name-$npm_package_version.zip dist"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm test"
    }
  },
  "dependencies": {
    "basic-auth-connect": "^1.1.0",
    "body-parser": "^2.3.0",
    "bower": "^1.8.14",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "handlebars": "^4.7.10",
    "mongodb": "^7.7.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "npm-run-all2": "^9.0.3",
    "object.omit": "^3.0.0",
    "replace-in-file": "^9.0.0",
    "sass": "^1.105.1",
    "usemin-cli": "^0.6.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "neostandard": "^0.14.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "html-minifier": "npm:html-minifier-terser@^7.2.0",
    "minimatch": "^10.2.6",
    "nodemon": {
      "chokidar": "5.0.0"
    },
    "yargs-parser": "^22.0.0"
  },
  "cacheDirectories": [
    "node_modules",
    "app/bower_components"
  ]
}
